@startuml application-seq-boot
title Application — boot sequence (bin -> cli -> node -> runtime)

actor OS
participant "bin/lean-rust main" as Main
participant "lean-cli (clap)" as Cli
participant "genesis / keygen" as Gen
participant "node::new_devnet" as Devnet
participant "core::Node" as Node

OS -> Main : exec (#[tokio::main])
Main -> Cli : lean_cli::cli::parse()
Cli --> Main : Cli
Main -> Cli : startup::init_tracing(&cli)

alt commands::dispatch(&cli) == Ok(Dispatch::Handled)
  Main -> Cli : commands::dispatch(&cli)
  Cli -> Gen : DevnetConfig | GeneratePrivateKey | PeerId | GenerateValidatorKeys
  Gen --> Cli : result
  Cli --> Main : Ok(Dispatch::Handled) (print result & return)
else Ok(Dispatch::RunNode)
  Main -> Cli : node_config::build_devnet_config(&cli)
  Cli -> Gen : load_chain_config / load_or_synthesize_state / anchor_block_for_state
  Gen --> Cli : ChainConfig, State, Block
  Cli --> Main : Ok(node::Config)
  Main -> Devnet : new_devnet(config)
  activate Devnet
  Devnet -> Devnet : MemoryStore, Engine::from_anchor, ChainService
  Devnet -> Devnet : DevnetHost::build_with_provider(RpcProviderAdapter)
  Devnet -> Devnet : GossipIngestService, DutiesService(PublisherAdapter), Http, Metrics
  Devnet --> Main : Node (wired, unstarted)
  deactivate Devnet
  Main -> Node : start()
  Main -> Cli : shutdown::wait().await  (SIGINT/SIGTERM)
  Main -> Node : stop()
end

@enduml
